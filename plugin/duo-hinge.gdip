
[config]
name="DuoHinge"
binary="duo-hinge.xcframework"
initialization="duo_hinge_init"
deinitialization="duo_hinge_deinit"
use_swift_runtime=true

[dependencies]
linked=[]
embedded=[]
system=["Foundation.framework","UIKit.framework","StoreKit.framework"]
capabilities=[]
files=[]
linker_flags=["-ObjC","-Wl,-weak-lswiftCore,-weak-lswiftObjectiveC,-weak-lswift_Concurrency"]

